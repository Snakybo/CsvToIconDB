{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Update Classic icons",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/update-icon-db.py",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"args": [
				"--input", "${input:csvFile}",
				"--output", "out/MediaClassic.lua",
				"--blacklist", "blacklist.txt",
				"--namespace", "ClickedMedia",
				"--function", "GetIcons",
				"--header", "file-header.txt"
			]
		},
